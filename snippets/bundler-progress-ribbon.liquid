<div class="milestone-ribbon">
  <div class="atelier-container ribbon-inner">
    <div class="ribbon-summary">
      <div class="ribbon-tier-status">
        <span class="badge-counter" id="ribbon-count-badge">0/3</span>
        <span class="tier-headline" id="ribbon-tier-label">Tier 01: Standard Retail</span>
      </div>
      <div class="ribbon-callout" id="ribbon-incentive-pill">
        <span class="incentive-text">Add 1 more formula to unlock <strong>10% OFF</strong></span>
      </div>
    </div>

    <div class="gauge-wrapper">
      <div class="gauge-track" id="bundle-progress-bar" style="width: 0%;"></div>
    </div>
    <div class="gauge-steps">
      <div class="gauge-step" data-step="1">
        <span class="step-dot"></span>
        <span class="step-title">Tier 01 • 1 Item</span>
        <span class="step-desc">Standard Retail</span>
      </div>
      <div class="gauge-step" data-step="2">
        <span class="step-dot"></span>
        <span class="step-title">Tier 02 • 2 Items</span>
        <span class="step-desc">10% Off Applied</span>
      </div>
      <div class="gauge-step" data-step="3">
        <span class="step-dot"></span>
        <span class="step-title">Tier 03 • 3 Items</span>
        <span class="step-desc">20% Off Coffret</span>
      </div>
    </div>
  </div>
</div>
