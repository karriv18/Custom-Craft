{{ 'bespoke-bundler.css' | asset_url | stylesheet_tag }}

<div class="coffret-vessel-card">
  <div class="card-header">
    <div>
      <span class="eyebrow-tag">Modular Vessel</span>
      <h2 class="card-title">The Presentation Coffret</h2>
      <p class="card-desc">Custom debossed keepsake box with velvet apothecary dividers.</p>
    </div>
    <span class="slot-counter-badge" id="coffret-slots-badge">0 / 3 Filled</span>
  </div>

  <div class="slots-container" id="coffret-slots-container">
    <div class="coffret-slot empty" data-slot="1">
      <div class="slot-placeholder">
        <span class="slot-plus-icon">+</span>
      </div>
      <div class="slot-info">
        <span class="slot-tag">Slot 01 • Empty</span>
        <h4 class="slot-title">Select 1st Formulation</h4>
      </div>
    </div>

    <div class="coffret-slot empty" data-slot="2">
      <div class="slot-placeholder">
        <span class="slot-plus-icon">+</span>
      </div>
      <div class="slot-info">
        <span class="slot-tag">Slot 02 • Empty</span>
        <h4 class="slot-title">Select 2nd Formulation</h4>
      </div>
    </div>

    <div class="coffret-slot empty" data-slot="3">
      <div class="slot-placeholder">
        <span class="slot-plus-icon">+</span>
      </div>
      <div class="slot-info">
        <span class="slot-tag">Slot 03 • Empty</span>
        <h4 class="slot-title">Select 3rd Formulation</h4>
      </div>
    </div>
  </div>

  <div class="vessel-tactile-guarantee">
    <span>✓ Archival Magnetic Clasp</span>
    <span>✓ FSC® Recycled Linen</span>
  </div>
</div>
