<div class="valuation-card">
  <div class="valuation-header">
    <span class="eyebrow-tag">Coffret Valuation</span>
    <span class="discount-pill" id="valuation-discount-badge">No Code</span>
  </div>

  <div class="valuation-breakdown">
    <div class="breakdown-row">
      <span>Combined Retail</span>
      <span class="original-price" id="val-retail-price">$0.00</span>
    </div>
    <div class="breakdown-row discount-row" id="val-discount-row">
      <span>Bundle Privilege Savings</span>
      <span id="val-savings-amount">-$0.00</span>
    </div>
    <div class="breakdown-row free-perk">
      <span>Presentation Coffret</span>
      <span class="free-tag">Complimentary ($35 Value)</span>
    </div>
    <div class="breakdown-row free-perk">
      <span>White Glove Dispatch</span>
      <span class="free-tag">Complimentary</span>
    </div>

    <div class="total-row">
      <div class="total-meta">
        <span class="total-label">Total Investment</span>
        <span class="tax-disclaimer">Taxes calculated at dispatch</span>
      </div>
      <div class="total-figure">
        <span class="final-price" id="val-final-total">$0.00</span>
      </div>
    </div>
  </div>

  <button type="button" class="btn-checkout" id="btn-claim-bundle" disabled>
    <span>Claim Bespoke Coffret</span>
    <span id="btn-price-display">$0.00 →</span>
  </button>
</div>
